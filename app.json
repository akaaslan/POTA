{
  "expo": {
    "name": "POTA",
    "slug": "POTA",
    "scheme": "pota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.knasln.pota",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDkk9xmxjAS0BMU9ym4_e6LTdBlArakEnI",
          "iosGoogleMapsApiKey": "AIzaSyDkk9xmxjAS0BMU9ym4_e6LTdBlArakEnI"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1e9474a-1b44-417c-95da-f0cffae2b014"
      }
    }
  }
}
